{
  "name": "x-portal",
  "private": true,
  "version": "1.3.1",
  "type": "module",
  "description": "Independent Xbox Remote Play launcher for macOS and Ubuntu ARM64",
  "author": "Mighty",
  "main": "electron/main.js",
  "build": {
    "appId": "com.mighty.xportal",
    "productName": "X Play macOS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/main.js",
      "electron/navigation.js",
      "shared/**/*",
      "build-preloads/**/*",
      "package.json",
      "support/registry.json"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.entertainment",
      "identity": "-"
    },
    "linux": {
      "target": "dir",
      "category": "Game",
      "executableName": "x-play"
    },
    "afterPack": "scripts/after-pack.cjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-preloads.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:start": "electron .",
    "electron:build": "npm run build && electron-builder --mac dmg --arm64",
    "test": "node --test tests/*.test.mjs",
    "test:site": "node scripts/test-site.mjs",
    "test:native": "node scripts/test-native.mjs"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.27.7",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "playwright": "1.64.1",
    "vite": "^8.0.0"
  }
}
